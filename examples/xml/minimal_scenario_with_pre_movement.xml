<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pre-movement (reaction) time.

  pre_movement is the number of seconds a person stands still before starting to
  walk. It models the time between the fire being detected and that particular
  person actually reacting: someone who sees the fire leaves at once, someone two
  rooms away reacts only to the alarm, and later.

  The attribute is optional and defaults to 0.0, which is the behaviour of every
  scenario written before it existed: everybody walks from t = 0.

  A person held back stands in place and is an obstacle to the others, which is
  what an unaware occupant actually is. Route choice is not affected.

  The numbers below are illustrative only. Which reaction times to apply is an
  engineering decision (vfdb guideline, PD 7974-6, ISO/TR 16738), not something
  this file should suggest.
-->
<scenario dt="0.01" max_iterations="20000">
  <model
    type="collision_free_speed"
    strength_neighbor_repulsion="8.0"
    range_neighbor_repulsion="0.1"
    strength_geometry_repulsion="5.0"
    range_geometry_repulsion="0.02"
  />

  <geometry>
    <walkable>
      <vertex x="0.0" y="0.0" />
      <vertex x="20.0" y="0.0" />
      <vertex x="20.0" y="10.0" />
      <vertex x="0.0" y="10.0" />
    </walkable>
  </geometry>

  <exit>
    <vertex x="18.0" y="4.0" />
    <vertex x="20.0" y="4.0" />
    <vertex x="20.0" y="6.0" />
    <vertex x="18.0" y="6.0" />
  </exit>

  <agents>
    <!-- Sees the fire, leaves immediately. -->
    <agent x="2.0" y="5.0" desired_speed="1.3" radius="0.2" time_gap="1.0"
           pre_movement="0.0" />
    <!-- Same room, needs a moment to grasp what is happening. -->
    <agent x="1.4" y="4.6" desired_speed="1.2" radius="0.2" time_gap="1.0"
           pre_movement="12.0" />
    <!-- Reacts to the alarm rather than to the fire itself. -->
    <agent x="1.4" y="5.4" desired_speed="1.2" radius="0.2" time_gap="1.0"
           pre_movement="45.0" />
    <!-- Collects belongings first; this tail is what sets the evacuation time. -->
    <agent x="0.8" y="5.0" desired_speed="1.1" radius="0.2" time_gap="1.0"
           pre_movement="80.0" />
  </agents>
</scenario>
